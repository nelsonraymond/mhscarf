 .font-display {
     font-family: var(--font-display);
 }
@@ -57,3 +68,63 @@ @keyframes MH Scarf-rise {
         transform: translateY(0);
     }
 }
+
+/* ---------------------------------------------------------------------------
+   Catalog mobile filter bottom-sheet (Tahap 2) — DESIGN.md §28/§38.
+   Plain CSS classes toggled by vanilla JS in catalog/index.blade.php via the
+   `is-open` state on #shop-filtersheet / #shop-filtersheet-backdrop.
+   Hidden above lg so desktop never sees the sheet. Motion respects
+   prefers-reduced-motion (transition removed → instant open/close).
+--------------------------------------------------------------------------- */
+#shop-filtersheet-backdrop {
+    position: fixed;
+    inset: 0;
+    z-index: 60;
+    background-color: rgba(58, 48, 51, 0.45); /* ink-tinted scrim, soft per brand */
+    opacity: 0;
+    visibility: hidden;
+    transition: opacity 0.3s ease-out, visibility 0.3s ease-out;
+}
+
+#shop-filtersheet-backdrop.is-open {
+    opacity: 1;
+    visibility: visible;
+}
+
+#shop-filtersheet {
+    position: fixed;
+    left: 0;
+    right: 0;
+    bottom: 0;
+    z-index: 70; /* above backdrop; below nothing else needed */
+    max-height: 85vh;
+    overflow-y: auto;
+    -webkit-overflow-scrolling: touch;
+    overscroll-behavior: contain;
+    background-color: #ffffff;
+    border-radius: 1rem 1rem 0 0;
+    box-shadow: 0 -12px 35px rgba(58, 48, 51, 0.12);
+    transform: translateY(100%);
+    visibility: hidden;
+    transition: transform 0.3s ease-out, visibility 0.3s ease-out;
+}
+
+#shop-filtersheet.is-open {
+    transform: translateY(0);
+    visibility: visible;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    #shop-filtersheet-backdrop,
+    #shop-filtersheet {
+        transition: none;
+    }
+}
+
+@media (min-width: 64rem) {
+    /* lg+ uses the inline toolbar; keep the sheet fully out of flow & view */
+    #shop-filtersheet,
+    #shop-filtersheet-backdrop {
+        display: none;
+    }
+}
